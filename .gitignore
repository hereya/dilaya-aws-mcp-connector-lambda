node_modules/
dist/
cdk.out/
*.js
*.d.ts
!jest.config.js
!lib/authorizer/index.js
# Whole directory, same trap as alarm-relay below: front-door.js (23/09) was
# silently ignored, and index.js requires it — the published authorizer would
# have crashed on load and taken every tenant site down with it.
!lib/frontend-authorizer/*.js
!lib/auth-lambda/**/*.js
!lib/cognito-triggers/**/*.js
!lib/byod-origin-restamp/index.js
# The alarm relay is hand-written source, not build output. Without this the
# blanket `*.js` above silently leaves lib/alarm-relay empty in the published
# package, and `Code.fromAsset` ships a Lambda with no handler.
# Whole directory on purpose: listing files one by one meant `announce.js` was
# ignored the moment it was added (2026-08-08), which is the same silent trap a
# second time.
!lib/alarm-relay/*.js
*.tsbuildinfo
.DS_Store
cdk.out/
cdk.context.json
